# =============================================================================
# VowPilot Server Configuration Template
# All secrets and credentials must be kept out of version control.
# Copy this file to .env.local for local development.
# =============================================================================

# Server Port
PORT=3001

# Application Environment (development | test | production)
NODE_ENV=development

# Session & Token Secret (Generate a strong 32+ character random string for production)
SESSION_SECRET=vowpilot_dev_synthetic_secret_change_in_production_32chars

# CORS Allowed Origins (Comma-separated list of trusted origins for production)
ALLOWED_ORIGINS=https://vowpilot.vercel.app,http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Email Provider Configuration (Phase 3)
# Leave unconfigured to use the built-in TestEmailProvider for local testing.
# For production SMTP delivery (e.g. AWS SES, SendGrid, Postmark, Resend):
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@example.com
# SMTP_PASS=your-smtp-password-placeholder
# EMAIL_FROM=coordinator@vowpilot.app

# -----------------------------------------------------------------------------
# Database Persistence Configuration
# VowPilot utilizes SQLite with Write-Ahead Logging (WAL) and foreign keys enabled.
# Specify the path where the database file will be stored.
# -----------------------------------------------------------------------------
DATABASE_PATH=./data/vowpilot.db
